<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İşçi Hakları Asistanı</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #1f2937;
        }

        header {
            background: #111827;
            color: white;
            padding: 22px 18px;
            text-align: center;
        }

        header h1 {
            margin: 0;
            font-size: 24px;
        }

        header p {
            margin: 8px 0 0;
            color: #cbd5e1;
            font-size: 14px;
        }

        .container {
            max-width: 900px;
            margin: auto;
            padding: 20px;
        }

        .welcome {
            background: white;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 18px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .welcome h2 {
            margin-top: 0;
        }

        .questions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
            margin-top: 15px;
        }

        .question-btn {
            border: none;
            background: #eef2ff;
            padding: 13px;
            border-radius: 10px;
            cursor: pointer;
            text-align: left;
            font-size: 14px;
        }

        .question-btn:hover {
            background: #e0e7ff;
        }

        .chat {
            background: white;
            border-radius: 16px;
            padding: 18px;
            min-height: 350px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        #messages {
            min-height: 250px;
            max-height: 500px;
            overflow-y: auto;
            padding: 5px;
        }

        .message {
            padding: 13px 15px;
            border-radius: 12px;
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .user {
            background: #111827;
            color: white;
            margin-left: 15%;
        }

        .assistant {
            background: #f1f5f9;
            margin-right: 10%;
        }

        .source {
            margin-top: 10px;
            padding: 10px;
            background: #fff7ed;
            border-left: 4px solid #f97316;
            font-size: 13px;
        }

        .input-area {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        #questionInput {
            flex: 1;
            padding: 14px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 15px;
            outline: none;
        }

        #sendButton {
            border: none;
            background: #111827;
            color: white;
            padding: 0 22px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
        }

        #sendButton:hover {
            background: #374151;
        }

        .warning {
            margin-top: 18px;
            font-size: 12px;
            color: #64748b;
            text-align: center;
        }

        @media (max-width: 600px) {
            .user {
                margin-left: 5%;
            }

            .assistant {
                margin-right: 5%;
            }

            .input-area {
                flex-direction: column;
            }

            #sendButton {
                padding: 14px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>⚖️ İşçi Hakları Asistanı</h1>
    <p>İş hukuku hakkında soru sor, mevzuat ve içtihatları incele.</p>
</header>

<div class="container">

    <div class="welcome">
        <h2>Nasıl yardımcı olabilirim?</h2>

        <p>
            Çalışma hayatınızla ilgili sorunuzu kendi cümlelerinizle yazabilirsiniz.
        </p>

        <div class="questions">
            <button class="question-btn" onclick="askQuestion('Fazla mesai ücretim nasıl hesaplanır?')">
                💰 Fazla mesai
            </button>

            <button class="question-btn" onclick="askQuestion('Pazar günü çalışırsam ayrıca ücret alır mıyım?')">
                📅 Hafta tatili
            </button>

            <button class="question-btn" onclick="askQuestion('Yıllık izin hakkım kaç gün?')">
                🏖️ Yıllık izin
            </button>

            <button class="question-btn" onclick="askQuestion('İşveren beni haklı neden olmadan işten çıkarabilir mi?')">
                📄 İşten çıkarma
            </button>

            <button class="question-btn" onclick="askQuestion('Resmi tatilde çalışırsam ücretim nasıl olur?')">
                🇹🇷 Resmi tatil
            </button>

            <button class="question-btn" onclick="askQuestion('İşveren maaşımı geç öderse hangi haklarım var?')">
                💳 Ücret
            </button>
        </div>
    </div>

    <div class="chat">

        <div id="messages">

            <div class="message assistant">
                Merhaba! 👋<br><br>
                İşçi haklarıyla ilgili sorunuzu yazabilirsiniz.
                Sorunuzu mümkün olduğunca ayrıntılı anlatırsanız daha doğru
                bir değerlendirme yapabilirim.
            </div>

        </div>

        <div class="input-area">

            <input
                type="text"
                id="questionInput"
                placeholder="Örneğin: Pazar günü çalıştım, ücretim nasıl hesaplanmalı?"
                onkeydown="handleEnter(event)"
            >

            <button id="sendButton" onclick="sendQuestion()">
                Sor
            </button>

        </div>

    </div>

    <div class="warning">
        ⚠️ Bu uygulama genel hukuki bilgilendirme amacıyla hazırlanmıştır.
        Somut olaylarda profesyonel hukuki danışmanlık alınması gerekebilir.
    </div>

</div>

<script>

function addMessage(text, type) {

    const messages = document.getElementById("messages");

    const message = document.createElement("div");

    message.className = "message " + type;

    message.innerHTML = text;

    messages.appendChild(message);

    messages.scrollTop = messages.scrollHeight;
}


function askQuestion(question) {

    document.getElementById("questionInput").value = question;

    sendQuestion();
}


function handleEnter(event) {

    if (event.key === "Enter") {
        sendQuestion();
    }
}


function sendQuestion() {

    const input = document.getElementById("questionInput");

    const question = input.value.trim();

    if (!question) {
        return;
    }

    addMessage(question, "user");

    input.value = "";

    setTimeout(function() {

        const answer = generateAnswer(question);

        addMessage(answer, "assistant");

    }, 500);
}


function generateAnswer(question) {

    const q = question.toLowerCase();

    if (
        q.includes("fazla mesai") ||
        q.includes("fazla çalışma") ||
        q.includes("mesai")
    ) {

        return `
            <strong>Fazla çalışma hakkında</strong><br><br>

            Genel kural olarak haftalık 45 saati aşan çalışmalar
            fazla çalışma kapsamında değerlendirilebilir.

            <div class="source">
                📚 <strong>Mevzuat:</strong><br>
                4857 sayılı İş Kanunu m.41
            </div>

            <div class="source">
                🏛️ <strong>Yargıtay:</strong><br>
                Somut olayın çalışma düzeni, puantaj kayıtları,
                bordrolar ve işyeri uygulaması incelenerek ilgili
                Yargıtay içtihatları ayrıca değerlendirilmelidir.
            </div>

            <br>
            Daha kesin değerlendirme için haftada kaç saat çalıştığınızı,
            kaç gün çalıştığınızı ve fazla çalışmanın nasıl kayda
            geçirildiğini belirtin.
        `;
    }


    if (
        q.includes("pazar") ||
        q.includes("hafta tatili")
    ) {

        return `
            <strong>Hafta tatili hakkında</strong><br><br>

            İşçinin hafta tatili hakkı ve bu günde yapılan çalışmanın
            ücretlendirilmesi, çalışma düzenine ve haftalık dinlenme
            hakkının kullandırılıp kullandırılmadığına göre değerlendirilir.

            <div class="source">
                📚 <strong>Mevzuat:</strong><br>
                4857 sayılı İş Kanunu m.46
            </div>

            <div class="source">
                🏛️ <strong>Yargıtay:</strong><br>
                Hafta tatili çalışmalarında işçinin haftalık çalışma
                düzeni ve hafta tatilinin gerçekten kullandırılıp
                kullandırılmadığı önem taşır.
            </div>

            <br>
            Hangi günler çalıştığınızı ve hangi günler izin yaptığınızı
            yazarsanız durumu daha ayrıntılı inceleyebiliriz.
        `;
    }


    if (
        q.includes("yıllık izin") ||
        q.includes("izin hakk")
    ) {

        return `
            <strong>Yıllık ücretli izin hakkında</strong><br><br>

            Yıllık izin süresi, işçinin aynı işverene bağlı çalışma
            süresine göre değişir.

            <div class="source">
                📚 <strong>Mevzuat:</strong><br>
                4857 sayılı İş Kanunu m.53
            </div>

            <br>
            İşyerindeki kıdem sürenizi yazarsanız genel izin sürenizi
            hesaplayabiliriz.
        `;
    }


    if (
        q.includes("resmi tatil") ||
        q.includes("bayram")
    ) {

        return `
            <strong>Ulusal bayram ve genel tatil çalışması</strong><br><br>

            Ulusal bayram ve genel tatil günlerinde çalışma yapılması
            halinde ayrıca ücret hakkı doğabilir.

            <div class="source">
                📚 <strong>Mevzuat:</strong><br>
                4857 sayılı İş Kanunu m.47
            </div>

            <br>
            Hangi resmi tatilde ve kaç saat çalıştığınızı belirtirseniz
            daha ayrıntılı değerlendirebiliriz.
        `;
    }


    if (
        q.includes("maaş") ||
        q.includes("ücret") ||
        q.includes("geç öde")
    ) {

        return `
            <strong>Ücret hakkında</strong><br><br>

            İşverenin ücret ödeme yükümlülüğü bulunmaktadır.
            Ücretin ödeme zamanı, sözleşme ve işyeri uygulaması ile
            birlikte değerlendirilmelidir.

            <div class="source">
                📚 <strong>Mevzuat:</strong><br>
                4857 sayılı İş Kanunu m.32
            </div>

            <br>
            Ücretinizin kaç gün geciktiğini belirtirseniz
            durumunuzu daha ayrıntılı inceleyebiliriz.
        `;
    }


    return `
        Sorunuzu aldım. 🔎<br><br>

        Bu ilk sürümde temel iş hukuku konularını tanıyabiliyorum.
        Sorunuz için daha doğru sonuç verebilmem adına olayınızı
        biraz daha ayrıntılı anlatabilirsiniz.

        <br><br>

        Örneğin:
        <br>
        • Ne kadar süredir çalışıyorsunuz?
        <br>
        • Haftada kaç gün çalışıyorsunuz?
        <br>
        • Günlük çalışma saatiniz kaç?
        <br>
        • İşveren size ne söyledi?
        <br>
        • Varsa TİS veya iş sözleşmesinde ne yazıyor?
    `;
}

</script>

</body>
</html>
